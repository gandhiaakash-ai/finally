# FinAlly environment variables
# Copy this file to `.env` at the project root and fill in values.
# The .env file is gitignored.

# Required: OpenRouter API key for the LLM chat assistant.
# Sign up at https://openrouter.ai/ and create a key.
OPENROUTER_API_KEY=

# Optional: Massive (Polygon.io) API key for real market data.
# Leave blank to use the built-in market simulator (recommended for most users).
MASSIVE_API_KEY=

# Optional: set to "true" for deterministic mock LLM responses.
# Used by the E2E test suite; leave as "false" for normal use.
LLM_MOCK=false
